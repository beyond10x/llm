{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReplayRun",
  "x-ess-name": "llm.calls.ReplayRun",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "candidate_route_id": {
      "type": "string",
      "x-ess-relation": {
        "name": "candidate",
        "kind": "references",
        "source": "llm.calls.ReplayRun",
        "target": "llm.catalog.Route",
        "cardinality": "one",
        "via": "candidate_route_id"
      }
    },
    "corpus_digest": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "money_cap": {
      "type": "string"
    },
    "reserve": {
      "type": "string"
    },
    "ledger_id": {
      "type": "string",
      "x-ess-relation": {
        "name": "ledger",
        "kind": "references",
        "source": "llm.calls.ReplayRun",
        "target": "llm.budget.Ledger",
        "cardinality": "one",
        "via": "ledger_id"
      }
    },
    "spent": {
      "type": "string"
    },
    "stopped": {
      "type": "string"
    },
    "cases": {
      "type": "integer"
    },
    "same": {
      "type": "integer"
    },
    "differs": {
      "type": "integer"
    },
    "failed": {
      "type": "integer"
    },
    "not_sent": {
      "type": "integer"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/llm.calls.CaseReport"
      }
    },
    "state": {
      "$ref": "#/$defs/llm.calls.ReplayRun.State"
    }
  },
  "required": [
    "id",
    "candidate_route_id",
    "corpus_digest",
    "currency",
    "money_cap",
    "reserve",
    "ledger_id",
    "spent",
    "cases",
    "same",
    "differs",
    "failed",
    "not_sent",
    "results",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "llm",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:4de5fb87ba34a655f5ec0505cfab4516120a6e30b3474ba331ae6214422e4c8c",
    "regenerate": "ess generate"
  },
  "$defs": {
    "llm.calls.CaseReport": {
      "title": "CaseReport",
      "x-ess-name": "llm.calls.CaseReport",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/llm.calls.CaseResult"
        },
        "error_code": {
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "result"
      ],
      "additionalProperties": false
    },
    "llm.calls.CaseResult": {
      "title": "CaseResult",
      "x-ess-name": "llm.calls.CaseResult",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Same",
        "Differs",
        "Failed",
        "NotSent"
      ]
    },
    "llm.calls.ReplayRun.State": {
      "title": "State",
      "x-ess-name": "llm.calls.ReplayRun.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Observed"
      ]
    }
  }
}
