{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DecisionResponse",
  "x-ess-name": "llm.decisions.DecisionResponse",
  "x-ess-kind": "entity",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "x-ess-relation": {
        "name": "request",
        "kind": "references",
        "source": "llm.decisions.DecisionResponse",
        "target": "llm.decisions.DecisionRequest",
        "cardinality": "one",
        "via": "request_id"
      }
    },
    "upstream_model": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/llm.decisions.QuestionAnswer"
      }
    },
    "input_tokens": {
      "type": "integer"
    },
    "output_tokens": {
      "type": "integer"
    },
    "cached_input_tokens": {
      "type": "integer"
    },
    "cache_creation_input_tokens": {
      "type": "integer"
    },
    "reasoning_output_tokens": {
      "type": "integer"
    },
    "call_record_id": {
      "type": "string",
      "x-ess-relation": {
        "name": "call",
        "kind": "references",
        "source": "llm.decisions.DecisionResponse",
        "target": "llm.calls.CallRecord",
        "cardinality": "one",
        "via": "call_record_id"
      }
    },
    "state": {
      "$ref": "#/$defs/llm.decisions.DecisionResponse.State"
    }
  },
  "required": [
    "id",
    "request_id",
    "upstream_model",
    "answers",
    "state"
  ],
  "additionalProperties": false,
  "x-ess-provenance": {
    "system": "llm",
    "specification_version": "v1",
    "contract_digest": "slice-sha256/2:93d5474c4d006971b9946cc83e75089daed92a7b641a128cb8cce0159ed58ddc",
    "regenerate": "ess generate"
  },
  "$defs": {
    "llm.decisions.AnswerKind": {
      "title": "AnswerKind",
      "x-ess-name": "llm.decisions.AnswerKind",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Predicate",
        "Choice",
        "Score",
        "Refusal"
      ]
    },
    "llm.decisions.ChoiceProbability": {
      "title": "ChoiceProbability",
      "x-ess-name": "llm.decisions.ChoiceProbability",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "value": {
          "$ref": "#/$defs/llm.decisions.ChoiceValue"
        },
        "probability": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "value",
        "probability"
      ],
      "additionalProperties": false
    },
    "llm.decisions.ChoiceValue": {
      "title": "ChoiceValue",
      "x-ess-name": "llm.decisions.ChoiceValue",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "flag": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "llm.decisions.DecisionResponse.State": {
      "title": "State",
      "x-ess-name": "llm.decisions.DecisionResponse.State",
      "x-ess-kind": "enum",
      "type": "string",
      "enum": [
        "Observed"
      ]
    },
    "llm.decisions.QuestionAnswer": {
      "title": "QuestionAnswer",
      "x-ess-name": "llm.decisions.QuestionAnswer",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/llm.decisions.AnswerKind"
        },
        "name": {
          "type": "string"
        },
        "probability": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "choice": {
          "$ref": "#/$defs/llm.decisions.ChoiceValue"
        },
        "choice_probabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/llm.decisions.ChoiceProbability"
          }
        },
        "score": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "score_probabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/llm.decisions.ScoreProbability"
          }
        },
        "confidence": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "kind",
        "choice_probabilities",
        "score_probabilities"
      ],
      "additionalProperties": false
    },
    "llm.decisions.ScoreProbability": {
      "title": "ScoreProbability",
      "x-ess-name": "llm.decisions.ScoreProbability",
      "x-ess-kind": "struct",
      "type": "object",
      "properties": {
        "value": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        },
        "probability": {
          "type": "string",
          "format": "decimal",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      },
      "required": [
        "value",
        "label",
        "probability"
      ],
      "additionalProperties": false
    }
  }
}
